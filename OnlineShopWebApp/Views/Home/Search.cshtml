@model List<ProductViewModel>
@{
    var query = ViewBag.Query as string;
    ViewData["Title"] = string.IsNullOrWhiteSpace(query) ? "Поиск" : $"Поиск: {query}";
}

<section class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item active" aria-current="page">Поиск</li>
        </ol>
    </nav>
    @if (string.IsNullOrWhiteSpace(query))
    {
        <h1>Что ищем?</h1>
        <p>Введите название растения в строке поиска вверху страницы</p>
    }
    else
    {
        <h1>«@query»</h1>
        <p>Найдено товаров: @(Model?.Count ?? 0)</p>
    }
</section>

@if (Model != null && Model.Any())
{
    <partial name="_ProductGrid" model="Model" />
}
else
{
    <div class="surface empty-state" data-reveal>
        <div class="ico"><i class="bi bi-search"></i></div>
        <h3>@(string.IsNullOrWhiteSpace(query) ? "Пустой запрос" : "Ничего не найдено")</h3>
        <p>Проверьте написание или попробуйте более общий запрос — например, «роза» или «ель».</p>
        <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-success btn-lg">
            <i class="bi bi-grid me-2"></i>Открыть каталог
        </a>
    </div>
}
