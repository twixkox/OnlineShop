@using System.Security.Claims
@using OnlineShop.Db.Interfaces
@inject ICategoryStorages CategoryStorages
@inject Microsoft.AspNetCore.Identity.UserManager<OnlineShop.Db.Models.User> UserManager
@inject OnlineShopWebApp.Services.ICartOwnerProvider CartOwner

@{
    var categories = (await CategoryStorages.GetAll()).OrderBy(c => c.Name).ToList();
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
    var isStaff = isAdmin || User.IsInRole("Manager");
    var currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
    var avatar = UiHelper.AvatarUrl(currentUser?.ProfileImage);
    var cartOwnerId = CartOwner.GetOwnerId(createIfMissing: false);
}

<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container gap-2">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="PlantShop — на главную">
                <span class="brand-mark"><i class="bi bi-flower1"></i></span>
                <span>Plant<em>Shop</em></span>
            </a>

            <div class="d-flex align-items-center gap-2 order-lg-last ms-auto ms-lg-0">
                <a class="icon-btn" asp-area="" asp-controller="Favorite" asp-action="Index" aria-label="Избранное" title="Избранное">
                    <i class="bi bi-heart"></i>
                    @if (isAuthenticated)
                    {
                        @await Component.InvokeAsync("Favorite", userId)
                    }
                    else
                    {
                        <span class="counter" data-counter="fav"></span>
                    }
                </a>
                <a class="icon-btn" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="Корзина" title="Корзина" data-cart-target>
                    <i class="bi bi-bag"></i>
                    <span class="d-none d-xl-inline">Корзина</span>
                    @await Component.InvokeAsync("Cart", cartOwnerId)
                </a>

                @if (isAuthenticated)
                {
                    <div class="dropdown">
                        <a class="avatar-btn dropdown-toggle d-block" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Меню пользователя">
                            <img src="@avatar" alt="@User.Identity!.Name" width="42" height="42">
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width: 250px;">
                            <li class="dropdown-head">
                                <small class="text-muted d-block">Вы вошли как</small>
                                <span class="fw-bold text-break">@User.Identity!.Name</span>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="ProfileEdit">
                                    <i class="bi bi-person me-2 text-success"></i>Личная информация
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="UserOrder">
                                    <i class="bi bi-bag-check me-2 text-success"></i>Мои заказы
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="EditPassword">
                                    <i class="bi bi-key me-2 text-success"></i>Сменить пароль
                                </a>
                            </li>
                            @if (isStaff)
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li class="px-3 pt-1 pb-1"><small class="text-uppercase fw-bold" style="color: var(--ps-terracotta); letter-spacing: .08em; font-size: .72rem;">Панель управления</small></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2 text-success"></i>Сводка</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Order" asp-action="Index"><i class="bi bi-truck me-2 text-success"></i>Заказы</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Product" asp-action="Index"><i class="bi bi-box-seam me-2 text-success"></i>Товары</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="bi bi-grid me-2 text-success"></i>Категории</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="PromoCode" asp-action="Index"><i class="bi bi-ticket-perforated me-2 text-success"></i>Промокоды</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Review" asp-action="Index"><i class="bi bi-chat-square-text me-2 text-success"></i>Отзывы</a></li>
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index"><i class="bi bi-people me-2 text-success"></i>Пользователи</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Role" asp-action="Index"><i class="bi bi-shield me-2 text-success"></i>Роли</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Journal" asp-action="Index"><i class="bi bi-journal-text me-2 text-success"></i>Журнал</a></li>
                                }
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-area="" asp-controller="Authorization" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Выйти
                                </a>
                            </li>
                        </ul>
                    </div>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Открыть меню">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="mainNav">
                <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 gap-lg-3 w-100 ms-lg-4 me-lg-3">
                    <div class="dropdown">
                        <button class="btn-catalog w-100 justify-content-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid-fill"></i> Каталог <i class="bi bi-chevron-down"></i>
                        </button>
                        <ul class="dropdown-menu catalog-menu">
                            <li>
                                <a class="dropdown-item" asp-area="" asp-controller="Catalog" asp-action="AllProducts">
                                    <span class="cat-ico"><i class="bi bi-grid-3x3-gap"></i></span>
                                    Все товары
                                </a>
                            </li>
                            <li><hr class="dropdown-divider mx-2"></li>
                            @foreach (var category in categories)
                            {
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Catalog" asp-action="Category"
                                       asp-route-slug="@category.IdentityUrl">
                                        <span class="cat-ico"><i class="bi @UiHelper.CategoryIcon(category.IdentityUrl)"></i></span>
                                        @category.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    @await Html.PartialAsync("SearchLine")

                    <a class="nav-link fw-semibold px-lg-2 d-none d-xl-block" asp-area="" asp-controller="Contacts" asp-action="Index">Контакты</a>

                    @if (!isAuthenticated)
                    {
                        <div class="d-flex gap-2 ms-lg-auto">
                            <button type="button" class="btn-pill-outline flex-fill" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Войти
                            </button>
                            <button type="button" class="btn-pill flex-fill text-nowrap" data-bs-toggle="modal" data-bs-target="#registrationModal">
                                Регистрация
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

@if (!isAuthenticated)
{
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content auth-modal">
                <div class="modal-header-primary">
                    <div class="modal-header-content">
                        <h5 class="modal-title" id="loginModalTitle">С возвращением!</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <p class="modal-subtitle">Войдите, чтобы оформлять заказы и сохранять избранное</p>
                </div>
                <div class="modal-body">
                    <form method="post" asp-area="" asp-controller="Authorization" asp-action="Authorization"
                          asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" id="loginForm">
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="loginUsername" name="UserName" placeholder=" " autocomplete="username" required>
                            <label for="loginUsername"><i class="bi bi-envelope me-1"></i> Email</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="loginPassword" name="Password" placeholder=" " autocomplete="current-password" required minlength="5">
                            <label for="loginPassword"><i class="bi bi-key me-1"></i> Пароль</label>
                            <span class="password-toggle" role="button" tabindex="0" aria-label="Показать пароль" onclick="togglePassword('loginPassword', this)">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="RememberMe" value="true" id="rememberMe" checked>
                                <label class="form-check-label small" for="rememberMe">Запомнить меня</label>
                            </div>
                            <a asp-area="" asp-controller="Authorization" asp-action="ForgotPassword" class="small fw-semibold text-decoration-none">Забыли пароль?</a>
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100 mb-3 auth-submit-btn">
                            Войти <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <p class="small text-muted text-center mb-0">
                            Нет аккаунта?
                            <button type="button" class="btn btn-link p-0 small" data-bs-toggle="modal" data-bs-target="#registrationModal">
                                Зарегистрироваться
                            </button>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="registrationModal" tabindex="-1" aria-labelledby="registrationModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content auth-modal">
                <div class="modal-header-primary">
                    <div class="modal-header-content">
                        <h5 class="modal-title" id="registrationModalTitle">Создать аккаунт</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <p class="modal-subtitle">Это займёт меньше минуты</p>
                </div>
                <div class="modal-body">
                    <form method="post" asp-area="" asp-controller="Registration" asp-action="Registration" id="registrationForm">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="regFirstName" name="FirstName" placeholder=" " autocomplete="given-name" required minlength="2" maxlength="25">
                                    <label for="regFirstName">Имя *</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="regLastName" name="LastName" placeholder=" " autocomplete="family-name" required minlength="2" maxlength="25">
                                    <label for="regLastName">Фамилия *</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="regUsername" name="UserName" placeholder=" " autocomplete="email" required maxlength="35">
                            <label for="regUsername">Email *</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input class="form-control phone-input" type="tel" id="regPhone" name="Phone" placeholder=" " autocomplete="tel" required>
                            <label for="regPhone">Телефон *</label>
                        </div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="password" class="form-control" id="regPassword" name="Password" placeholder=" " autocomplete="new-password" required minlength="5" maxlength="25">
                                    <label for="regPassword">Пароль *</label>
                                    <span class="password-toggle" role="button" tabindex="0" aria-label="Показать пароль" onclick="togglePassword('regPassword', this)"><i class="bi bi-eye"></i></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="password" class="form-control" id="regPasswordConfirm" name="ReplayPassword" placeholder=" " autocomplete="new-password" required minlength="5" maxlength="25">
                                    <label for="regPasswordConfirm">Повторите *</label>
                                    <span class="password-toggle" role="button" tabindex="0" aria-label="Показать пароль" onclick="togglePassword('regPasswordConfirm', this)"><i class="bi bi-eye"></i></span>
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100 mb-3 auth-submit-btn">
                            Зарегистрироваться <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <p class="small text-muted text-center mb-0">
                            Уже есть аккаунт?
                            <button type="button" class="btn btn-link p-0 small" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Войти
                            </button>
                        </p>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
