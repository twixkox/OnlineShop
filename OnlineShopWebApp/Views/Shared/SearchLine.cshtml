<form asp-area="" asp-controller="Home" asp-action="Search" method="get" class="search-pill flex-grow-1" role="search">
    <i class="bi bi-search"></i>
    <input class="form-control" type="search" name="query" value="@Context.Request.Query["query"]"
           placeholder="Найти растение, например «туя»" aria-label="Поиск по магазину" autocomplete="off">
    <button type="submit" aria-label="Искать"><i class="bi bi-arrow-right"></i></button>
</form>
