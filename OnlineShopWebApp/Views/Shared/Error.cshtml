@{
    ViewData["Title"] = "Что-то пошло не так";
    var code = ViewData["StatusCode"] as int?;
    var err = Model as ErrorViewModel;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="surface empty-state" data-reveal>
            <div class="ico" style="background:#fdecea; color: var(--ps-danger);"><i class="bi @(code == 403 ? "bi-shield-lock" : "bi-cloud-drizzle")"></i></div>
            @if (code == 403)
            {
                <h3>Нет доступа</h3>
                <p>У вашей учётной записи нет прав для просмотра этой страницы.</p>
            }
            else
            {
                <h3>Что-то пошло не так</h3>
                <p>Мы уже знаем о проблеме и разбираемся. Попробуйте обновить страницу чуть позже.</p>
            }
            @if (err?.ShowRequestId == true)
            {
                <p class="small text-muted">Код запроса: <code>@err.RequestId</code></p>
            }
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg"><i class="bi bi-house me-2"></i>На главную</a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg">Назад</a>
            </div>
        </div>
    </div>
</div>
