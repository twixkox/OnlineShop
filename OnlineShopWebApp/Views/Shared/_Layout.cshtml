<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PlantShop — питомник растений: саженцы, цветы и товары для сада с доставкой." />
    <meta name="theme-color" content="#1f4d3a" />
    <title>@(ViewData["Title"] is string t && !string.IsNullOrEmpty(t) ? $"{t} — PlantShop" : "PlantShop — питомник растений")</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%231f4d3a'/%3E%3Cpath d='M16 26c0-7-1-12-7-16 8 0 10 6 7 16zm1 0c0-6 3-10 8-12-1 6-4 10-8 12z' fill='%2374c69d'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,600&family=Manrope:wght@400;500;600;700;800&display=swap&subset=cyrillic" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="scroll-progress" aria-hidden="true"></div>

    @await Html.PartialAsync("Header")

    <main role="main" class="site-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("_Footer")

    <button type="button" class="to-top" aria-label="Наверх"><i class="bi bi-arrow-up"></i></button>

    @* Сообщения из TempData показываются всплывающими уведомлениями *@
    <div hidden>
        @if (TempData["SuccessMessage"] is string success)
        {
            <span data-flash="@success" data-type="success"></span>
        }
        @if (TempData["InfoMessage"] is string info)
        {
            <span data-flash="@info" data-type="info"></span>
        }
        @if (TempData["ErrorMessage"] is string error)
        {
            <span data-flash="@error" data-type="error"></span>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/PhoneFormatter.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
