@using System.Security.Claims
@using OnlineShop.Db.Interfaces
@model ProductViewModel
@inject IFavoritesStorages FavoritesStorages
@{
    ViewData["Title"] = Model?.Name ?? "Товар не найден";
    var category = ViewBag.Category as OnlineShop.Db.Models.Category;
    var related = ViewBag.Related as List<ProductViewModel> ?? new();

    var isFavorite = false;
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (Model != null && userId != null)
    {
        var fav = await FavoritesStorages.TryGetByUserIdAsync(userId);
        isFavorite = fav?.Products?.Any(p => p.Id == Model.Id) == true;
    }
}

@if (Model == null)
{
    <div class="surface empty-state mt-3" data-reveal>
        <div class="ico"><i class="bi bi-flower3"></i></div>
        <h3>Товар не найден</h3>
        <p>Возможно, он закончился или ссылка устарела. Посмотрите другие растения в каталоге.</p>
        <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-success btn-lg">
            <i class="bi bi-arrow-left me-2"></i>В каталог
        </a>
    </div>
    return;
}

@{
    var image = UiHelper.ImageUrl(Model.PhotoPath);
    var isPlaceholder = image == UiHelper.PlaceholderImage;
}

<nav aria-label="breadcrumb" class="mb-3" data-reveal>
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
        <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="AllProducts">Каталог</a></li>
        @if (category != null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Catalog" asp-action="CurrentCategory" asp-route-identityUrl="@category.IdentityUrl" asp-route-categoryId="@category.Id">@category.Name</a>
            </li>
        }
        <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 18rem;">@Model.Name</li>
    </ol>
</nav>

<div class="row g-4 g-lg-5 mb-5" data-product>
    <div class="col-lg-6" data-reveal>
        <div class="product-gallery">
            <img src="@image" alt="@Model.Name" class="@(isPlaceholder ? "is-placeholder" : "")" style="--hue: @(UiHelper.Hue(Model.Id))deg">
        </div>
    </div>

    <div class="col-lg-6" data-reveal style="--d:.1s">
        @if (category != null)
        {
            <a class="chip mb-3" asp-controller="Catalog" asp-action="CurrentCategory" asp-route-identityUrl="@category.IdentityUrl" asp-route-categoryId="@category.Id">
                <i class="bi @UiHelper.CategoryIcon(category.IdentityUrl)"></i> @category.Name
            </a>
        }
        <h1 class="mb-3" style="font-size: clamp(1.8rem, 3.5vw, 2.6rem);">@Model.Name</h1>

        <div class="d-flex align-items-center gap-3 mb-4">
            <span class="price price-lg">@Model.Cost.ToString("C0")</span>
        </div>

        <p class="text-muted mb-4" style="font-size: 1.05rem; line-height: 1.75;">@Model.Description</p>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <a class="btn btn-success btn-lg flex-grow-1 flex-sm-grow-0 px-4" data-add-to-cart
               href="@Url.Action("Add", "Cart", new { productId = Model.Id })">
                <i class="bi bi-bag-plus me-2"></i><span class="label">Добавить в корзину</span>
            </a>
            <a class="btn btn-outline-success btn-lg px-4 @(isFavorite ? "is-active" : "")" data-fav-toggle data-id="@Model.Id"
               href="@Url.Action("Toggle", "Favorite", new { productId = Model.Id })" aria-pressed="@(isFavorite ? "true" : "false")">
                <i class="bi @(isFavorite ? "bi-heart-fill" : "bi-heart") me-2"></i><span class="label">@(isFavorite ? "В избранном" : "В избранное")</span>
            </a>
        </div>

        <div class="surface p-4">
            <ul class="info-list">
                <li><i class="bi bi-truck"></i><span><strong class="text-body">Доставка в удобный день</strong> — выберите дату при оформлении заказа</span></li>
                <li><i class="bi bi-flower1"></i><span><strong class="text-body">Совет по посадке</strong> — расскажем, как посадить и ухаживать</span></li>
                <li><i class="bi bi-chat-dots"></i><span><strong class="text-body">Нужен совет?</strong> Позвоните: <a href="tel:+78129250508">+7 (812) 925-05-08</a></span></li>
            </ul>
        </div>
    </div>
</div>

@if (related.Any())
{
    <section>
        <div class="section-title" data-reveal>
            <div>
                <div class="eyebrow">Из этой же категории</div>
                <h2>Вам может понравиться</h2>
            </div>
            @if (category != null)
            {
                <a class="link-arrow" asp-controller="Catalog" asp-action="CurrentCategory" asp-route-identityUrl="@category.IdentityUrl" asp-route-categoryId="@category.Id">Вся категория <i class="bi bi-arrow-right"></i></a>
            }
        </div>
        @{
            ViewData["HideCategory"] = true;
        }
        <partial name="_ProductGrid" model="related" />
    </section>
}
