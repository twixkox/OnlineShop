@model List<ProductViewModel>
@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Каталог";
    ViewData["HideCategory"] = true;
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item"><a asp-controller="Catalog" asp-action="AllProducts">Каталог</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>
        <h1>@ViewData["Title"]</h1>
        @if (ViewBag.CategoryDescription != null)
        {
            <p>@ViewBag.CategoryDescription</p>
        }
    </div>
</section>

<partial name="_CatalogBody" model="Model" />
