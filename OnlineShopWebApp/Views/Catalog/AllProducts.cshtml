@model List<ProductViewModel>
@{
    ViewData["Title"] = "Каталог";
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">Каталог</li>
            </ol>
        </nav>
        <h1>Каталог растений</h1>
        <p>Саженцы, цветы и всё для ухода за садом — @Model.Count @Plural(Model.Count, "товар", "товара", "товаров") в наличии</p>
    </div>
</section>

<partial name="_CatalogBody" model="Model" />

@functions {
    private static string Plural(int n, string one, string few, string many)
    {
        n = Math.Abs(n) % 100;
        var n1 = n % 10;
        if (n > 10 && n < 20) return many;
        if (n1 > 1 && n1 < 5) return few;
        if (n1 == 1) return one;
        return many;
    }
}
