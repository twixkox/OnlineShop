@{
    ViewData["Title"] = "Контакты";
}

<section class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item active" aria-current="page">Контакты</li>
        </ol>
    </nav>
    <h1>Как с нами связаться</h1>
    <p>Приезжайте в питомник, звоните или пишите — поможем с выбором растений</p>
</section>

<div class="row g-3 g-lg-4 mb-4" data-stagger=".07">
    <div class="col-sm-6 col-lg-3">
        <div class="contact-tile">
            <div class="feature-ico"><i class="bi bi-telephone"></i></div>
            <div><div class="text-muted small">Телефон</div><a href="tel:+78129250508">+7 (812) 925-05-08</a></div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="contact-tile">
            <div class="feature-ico"><i class="bi bi-envelope"></i></div>
            <div><div class="text-muted small">Email</div><a href="mailto:vopros@rus.garden">vopros@rus.garden</a></div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="contact-tile">
            <div class="feature-ico"><i class="bi bi-clock"></i></div>
            <div><div class="text-muted small">Режим работы</div><strong>Ежедневно 10:00 — 19:00</strong></div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="contact-tile">
            <div class="feature-ico"><i class="bi bi-telegram"></i></div>
            <div><div class="text-muted small">Telegram</div><a href="https://t.me/twixkox" target="_blank" rel="noopener">@@twixkox</a></div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7" data-reveal>
        <div class="surface overflow-hidden h-100" style="min-height: 360px;">
            <iframe title="PlantShop на карте" src="https://yandex.ru/map-widget/v1/?text=%D0%BF%D0%BE%D1%81.%20%D0%A1%D0%BE%D1%81%D0%BD%D0%BE%D0%B2%D0%BE%2C%20%D1%83%D0%BB.%20%D0%A1%D0%B0%D0%B4%D0%BE%D0%B2%D0%B0%D1%8F%2C%201&z=14"
                    width="100%" height="100%" style="border:0; min-height:360px; display:block;" loading="lazy" allowfullscreen></iframe>
        </div>
    </div>
    <div class="col-lg-5" data-reveal style="--d:.1s">
        <div class="surface surface-pad h-100">
            <h5 class="mb-3"><i class="bi bi-geo-alt text-success me-2"></i>Адрес питомника</h5>
            <p class="mb-1 fw-semibold">Ленинградская обл., Приозерский р-н,</p>
            <p class="mb-3 fw-semibold">пос. Сосново, ул. Садовая, 1</p>
            <p class="text-muted small mb-4">Есть парковка у входа.</p>
            <a href="https://yandex.ru/maps/-/CPR7n2-C" target="_blank" rel="noopener" class="btn btn-success mb-4">
                <i class="bi bi-sign-turn-right me-2"></i>Построить маршрут
            </a>

            <h5 id="delivery" class="mb-3 mt-2" style="scroll-margin-top: 110px;"><i class="bi bi-truck text-success me-2"></i>Доставка</h5>
            <ul class="info-list">
                <li><i class="bi bi-calendar-check"></i>Дату доставки вы выбираете сами при оформлении — до 3 месяцев вперёд</li>
                <li><i class="bi bi-map"></i>Точку доставки можно отметить прямо на карте</li>
                <li><i class="bi bi-telephone-outbound"></i>Менеджер позвонит, чтобы подтвердить заказ и стоимость доставки</li>
            </ul>
        </div>
    </div>
</div>
