@model CartViewModel
@{
    ViewData["Title"] = "Корзина";
    var hasItems = Model != null && Model.Items.Count > 0;
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">Корзина</li>
            </ol>
        </nav>
        <h1>Корзина</h1>
        <p>
            @if (hasItems)
            {
                <span>Товаров: <strong data-cart-count>@Model!.Quantity</strong> на сумму <strong data-cart-total>@Model.TotalCost.ToString("C0")</strong></span>
            }
            else
            {
                <span>Пока здесь ничего нет</span>
            }
        </p>
    </div>
    <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-light">
        <i class="bi bi-arrow-left me-1"></i>Продолжить покупки
    </a>
</section>

@if (hasItems)
{
    <div class="steps" data-reveal>
        <span class="step current"><span class="num">1</span>Корзина</span>
        <span class="line"></span>
        <span class="step"><span class="num">2</span>Доставка</span>
        <span class="line"></span>
        <span class="step"><span class="num">3</span>Готово</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="surface surface-pad" data-reveal>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">Состав заказа</h5>
                    <a asp-controller="Cart" asp-action="Clear" class="btn btn-sm btn-outline-secondary"
                       data-confirm="Очистить корзину?">
                        <i class="bi bi-trash3 me-1"></i>Очистить
                    </a>
                </div>

                @foreach (var item in Model!.Items)
                {
                    var image = UiHelper.ProductImage(item.Product.ThumbnailsPhotoPath, item.Product.PhotoPath);
                    <div class="cart-row">
                        <a class="cart-thumb" asp-controller="Product" asp-action="Index" asp-route-id="@item.Product.Id">
                            <img src="@image" alt="@item.Product.Name" class="@(image == UiHelper.PlaceholderImage ? "is-placeholder" : "")" loading="lazy">
                        </a>
                        <div>
                            <a class="name" asp-controller="Product" asp-action="Index" asp-route-id="@item.Product.Id">@item.Product.Name</a>
                            <div class="text-muted small mt-1">@item.Product.Cost.ToString("C0") за шт.</div>
                        </div>
                        <div class="controls">
                            <div class="qty" aria-label="Количество">
                                <a asp-controller="Cart" asp-action="Subtract" asp-route-productId="@item.Product.Id" data-cart-action aria-label="Уменьшить">
                                    <i class="bi bi-dash-lg"></i>
                                </a>
                                <span class="val" data-qty>@item.Quantity</span>
                                <a asp-controller="Cart" asp-action="Add" asp-route-productId="@item.Product.Id" data-cart-action aria-label="Увеличить">
                                    <i class="bi bi-plus-lg"></i>
                                </a>
                            </div>
                            <span class="line-total" data-line-total>@item.Cost.ToString("C0")</span>
                            <a class="remove-btn" asp-controller="Cart" asp-action="Remove" asp-route-productId="@item.Product.Id" data-cart-action aria-label="Удалить" title="Удалить">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <aside class="surface surface-pad summary" data-reveal style="--d:.1s">
                <h5 class="mb-3">Итого</h5>
                <div class="summary-line"><span>Товары (<span data-cart-count>@Model.Quantity</span>)</span><span data-cart-total>@Model.TotalCost.ToString("C0")</span></div>
                <div class="summary-line"><span>Доставка</span><span>рассчитает менеджер</span></div>
                <div class="summary-total mb-4">
                    <span class="fw-bold">К оплате</span>
                    <span class="price" data-cart-total>@Model.TotalCost.ToString("C0")</span>
                </div>
                <a asp-controller="Order" asp-action="Index" class="btn btn-success btn-lg w-100">
                    Оформить заказ <i class="bi bi-arrow-right ms-2"></i>
                </a>
                <p class="small text-muted text-center mt-3 mb-0"><i class="bi bi-shield-lock me-1"></i>Данные защищены</p>
            </aside>
        </div>
    </div>
}
else
{
    <div class="surface empty-state" data-reveal>
        <div class="ico"><i class="bi bi-bag"></i></div>
        <h3>Корзина пуста</h3>
        <p>Загляните в каталог — там много растений, которые украсят ваш сад.</p>
        <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-success btn-lg">
            <i class="bi bi-grid me-2"></i>Перейти в каталог
        </a>
    </div>
}
