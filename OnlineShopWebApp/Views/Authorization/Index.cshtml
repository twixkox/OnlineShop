@model AuthorizationUserViewModel
@{
    ViewData["Title"] = "Вход";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center py-lg-4">
    <div class="col-xl-10">
        <div class="auth-card">
            <div class="row g-0">
                <div class="col-md-5">
                    <div class="auth-side d-flex flex-column justify-content-between">
                        <div>
                            <div class="eyebrow" style="color:#ffd8a8">PlantShop</div>
                            <h2 class="mb-3">С возвращением!</h2>
                            <p>Войдите, чтобы оформлять заказы, следить за их статусом и сохранять понравившиеся растения.</p>
                        </div>
                        <ul class="list-unstyled d-grid gap-3 mt-4 mb-0">
                            <li class="d-flex gap-2 align-items-center"><i class="bi bi-truck"></i> Доставка в удобный день</li>
                            <li class="d-flex gap-2 align-items-center"><i class="bi bi-heart"></i> Избранное всегда под рукой</li>
                            <li class="d-flex gap-2 align-items-center"><i class="bi bi-clock-history"></i> История заказов</li>
                        </ul>
                        <i class="bi bi-flower1 leaf-deco" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="p-4 p-lg-5">
                        <h1 class="h2 mb-1">Вход в аккаунт</h1>
                        <p class="text-muted mb-4">Нет аккаунта? <a asp-controller="Registration" asp-action="Index" class="fw-bold text-decoration-none">Зарегистрируйтесь</a></p>

                        <form method="post" asp-controller="Authorization" asp-action="Authorization" asp-route-returnUrl="@returnUrl">
                            <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">Email</label>
                                <div class="form-icon-field">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="UserName" class="form-control form-control-lg" placeholder="you@example.com" autocomplete="username" autofocus />
                                </div>
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">Пароль</label>
                                <div class="form-icon-field">
                                    <i class="bi bi-lock"></i>
                                    <input asp-for="Password" class="form-control form-control-lg" type="password" id="password" placeholder="••••••••" autocomplete="current-password" />
                                    <button class="pass-toggle" type="button" onclick="togglePassword('password', this)" aria-label="Показать пароль"><i class="bi bi-eye"></i></button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                                <label asp-for="RememberMe" class="form-check-label">Запомнить меня на этом устройстве</label>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100">
                                Войти <i class="bi bi-arrow-right ms-2"></i>
                            </button>
                        </form>

                        <p class="small text-muted text-center mt-4 mb-0"><i class="bi bi-shield-check text-success me-1"></i>Ваши данные надёжно защищены</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
