@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Восстановление пароля";
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-8 col-lg-5">
        <div class="auth-card p-4 p-lg-5">
            <div class="feature-ico mb-3"><i class="bi bi-key"></i></div>
            <h1 class="h2 mb-2">Забыли пароль?</h1>
            <p class="text-muted mb-4">Укажите email, с которым регистрировались, — пришлём ссылку для создания нового пароля.</p>
            <form asp-controller="Authorization" asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="form-icon-field">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="you@example.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Отправить ссылку</button>
            </form>
            <p class="text-center small text-muted mt-4 mb-0">Вспомнили? <a asp-controller="Authorization" asp-action="Index" class="fw-bold text-decoration-none">Войти</a></p>
        </div>
    </div>
</div>
