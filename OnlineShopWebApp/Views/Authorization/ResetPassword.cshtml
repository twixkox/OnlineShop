@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Новый пароль";
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-8 col-lg-5">
        <div class="auth-card p-4 p-lg-5">
            <div class="feature-ico mb-3"><i class="bi bi-shield-lock"></i></div>
            <h1 class="h2 mb-2">Новый пароль</h1>
            <p class="text-muted mb-4">для <strong class="text-body">@Model.Email</strong></p>
            <form asp-controller="Authorization" asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors" role="alert"></div>
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="form-icon-field">
                        <i class="bi bi-key"></i>
                        <input asp-for="Password" class="form-control form-control-lg" id="newPass" autocomplete="new-password" />
                        <button class="pass-toggle" type="button" onclick="togglePassword('newPass', this)" aria-label="Показать пароль"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <div class="form-icon-field">
                        <i class="bi bi-check2-circle"></i>
                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Сохранить пароль</button>
            </form>
        </div>
    </div>
</div>
