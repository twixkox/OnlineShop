@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Проверьте почту";
}

<div class="row justify-content-center py-lg-4">
    <div class="col-md-8 col-lg-5">
        <div class="auth-card p-4 p-lg-5 text-center">
            <div class="empty-state p-0">
                <div class="ico"><i class="bi bi-envelope-check"></i></div>
            </div>
            <h1 class="h2 mb-3">Проверьте почту</h1>
            <p class="text-muted">Если аккаунт с адресом <strong class="text-body">@Model.Email</strong> существует, мы отправили на него ссылку для восстановления пароля. Ссылка действует ограниченное время.</p>
            <p class="small text-muted mb-4">Письма нет? Загляните в «Спам» или запросите ссылку ещё раз.</p>
            <a asp-controller="Authorization" asp-action="Index" class="btn btn-success btn-lg">Ко входу</a>
        </div>
    </div>
</div>
