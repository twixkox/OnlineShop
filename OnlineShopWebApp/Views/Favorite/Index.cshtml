@model FavoriteViewModel
@{
    ViewData["Title"] = "Избранное";
    var items = (Model?.Items ?? new()).ToProductsViewModels();
    ViewData["FavoriteIds"] = items.Select(i => i.Id).ToHashSet();
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">Избранное</li>
            </ol>
        </nav>
        <h1>Избранное</h1>
        <p>@(items.Any() ? $"Сохранено товаров: {items.Count}" : "Сохраняйте понравившиеся растения, чтобы не потерять их")</p>
    </div>
    <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-light">
        <i class="bi bi-arrow-left me-1"></i>В каталог
    </a>
</section>

@if (items.Any())
{
    ViewData["RemoveOnUnfav"] = true;
    <partial name="_ProductGrid" model="items" view-data="ViewData" />
}
else
{
    <div class="surface empty-state" data-reveal>
        <div class="ico"><i class="bi bi-heart"></i></div>
        <h3>В избранном пока пусто</h3>
        <p>Нажмите на сердечко на карточке товара — и он появится здесь.</p>
        <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-success btn-lg">
            <i class="bi bi-grid me-2"></i>Перейти в каталог
        </a>
    </div>
}
