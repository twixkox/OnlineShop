@using OnlineShop.Db.Models
@model OrderViewModel
@inject IConfiguration Configuration
@{
    var mapsKey = Configuration["YandexMaps:ApiKey"];
    var onlineEnabled = ViewBag.OnlinePaymentEnabled is true;
    ViewData["Title"] = "Оформление заказа";
    var minDate = DateTime.Today.ToString("yyyy-MM-dd");
    var maxDate = DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd");
}

@section Head {
    @if (!string.IsNullOrWhiteSpace(mapsKey))
    {
        <script src="https://api-maps.yandex.ru/2.1/?apikey=@mapsKey&lang=ru_RU" defer></script>
    }
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Корзина</a></li>
                <li class="breadcrumb-item active" aria-current="page">Оформление</li>
            </ol>
        </nav>
        <h1>Оформление заказа</h1>
        <p>Осталось указать, куда и когда привезти растения</p>
    </div>
    <a asp-controller="Cart" asp-action="Index" class="btn btn-light">
        <i class="bi bi-arrow-left me-1"></i>Назад в корзину
    </a>
</section>

<div class="steps" data-reveal>
    <span class="step done"><span class="num"><i class="bi bi-check-lg"></i></span>Корзина</span>
    <span class="line done"></span>
    <span class="step current"><span class="num">2</span>Доставка</span>
    <span class="line"></span>
    <span class="step"><span class="num">3</span>Готово</span>
</div>

<form asp-controller="Order" asp-action="Buy" method="post">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="surface surface-pad mb-4" data-reveal>
                <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors" role="alert"></div>

                <h5 class="mb-3"><i class="bi bi-person-circle text-success me-2"></i>Получатель</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="DeliveryUserInfo.UserName"></label>
                        <div class="form-icon-field">
                            <i class="bi bi-person"></i>
                            <input class="form-control" asp-for="DeliveryUserInfo.UserName" placeholder="Иван Иванов" autocomplete="name" />
                        </div>
                        <span asp-validation-for="DeliveryUserInfo.UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="DeliveryUserInfo.Phone"></label>
                        <div class="form-icon-field">
                            <i class="bi bi-telephone"></i>
                            <input class="form-control phone-input" asp-for="DeliveryUserInfo.Phone" type="tel" placeholder="+7 (999) 999-99-99" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="DeliveryUserInfo.Phone" class="text-danger small"></span>
                    </div>
                </div>

                <h5 class="mb-3"><i class="bi bi-geo-alt text-success me-2"></i>Доставка</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" asp-for="DeliveryUserInfo.Adress"></label>
                        <div class="form-icon-field">
                            <i class="bi bi-signpost-split"></i>
                            <input class="form-control" asp-for="DeliveryUserInfo.Adress" id="deliveryAddress" placeholder="Город, улица, дом" autocomplete="street-address" />
                        </div>
                        <span asp-validation-for="DeliveryUserInfo.Adress" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="DeliveryUserInfo.Apartment"></label>
                        <input class="form-control" asp-for="DeliveryUserInfo.Apartment" placeholder="кв./офис или «частный дом»" />
                        <span asp-validation-for="DeliveryUserInfo.Apartment" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-text mb-2"><i class="bi bi-hand-index me-1"></i>Кликните по карте — адрес подставится автоматически</div>
                        <div id="map" class="map-box"></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="DeliveryUserInfo.DeliveryDate"></label>
                        <div class="form-icon-field">
                            <i class="bi bi-calendar-event"></i>
                            <input class="form-control" asp-for="DeliveryUserInfo.DeliveryDate" type="date" min="@minDate" max="@maxDate" />
                        </div>
                        <span asp-validation-for="DeliveryUserInfo.DeliveryDate" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <span class="form-label d-block">Способ оплаты</span>
                        <div class="pay-options">
                            <label class="pay-option">
                                <input type="radio" name="PaymentMethod" value="@PaymentMethod.OnDelivery" checked="@(Model.PaymentMethod == PaymentMethod.OnDelivery || !onlineEnabled)">
                                <span><i class="bi bi-cash-coin"></i><strong>При получении</strong><small>Наличными или картой курьеру</small></span>
                            </label>
                            <label class="pay-option @(onlineEnabled ? "" : "is-disabled")" title="@(onlineEnabled ? "" : "Онлайн-оплата скоро появится")">
                                <input type="radio" name="PaymentMethod" value="@PaymentMethod.Online" checked="@(onlineEnabled && Model.PaymentMethod == PaymentMethod.Online)" disabled="@(!onlineEnabled)">
                                <span><i class="bi bi-credit-card"></i><strong>Онлайн</strong><small>@(onlineEnabled ? "Картой или СБП через ЮKassa" : "Скоро появится")</small></span>
                            </label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" asp-for="DeliveryUserInfo.Comment"></label>
                        <textarea class="form-control" asp-for="DeliveryUserInfo.Comment" rows="3" placeholder="Например: позвонить за час до приезда"></textarea>
                        <span asp-validation-for="DeliveryUserInfo.Comment" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <aside class="surface surface-pad summary" data-reveal style="--d:.1s">
                <h5 class="mb-2">Ваш заказ</h5>
                @foreach (var item in Model.Items)
                {
                    var image = UiHelper.ProductImage(item.Product.ThumbnailsPhotoPath, item.Product.PhotoPath);
                    <div class="d-flex align-items-center gap-3 py-2">
                        <div class="cart-thumb" style="width:56px;height:56px;border-radius:12px;">
                            <img src="@image" alt="" class="@(image == UiHelper.PlaceholderImage ? "is-placeholder" : "")">
                        </div>
                        <div class="flex-grow-1 small">
                            <div class="fw-semibold">@item.Product.Name</div>
                            <div class="text-muted">@item.Quantity × @item.Product.Cost.ToString("C0")</div>
                        </div>
                        <div class="fw-bold text-nowrap">@item.Cost.ToString("C0")</div>
                    </div>
                }
                @if (Model.DiscountPercent > 0)
                {
                    <div class="summary-line text-success mt-2">
                        <span>Скидка @Model.DiscountPercent% <span class="promo-chip">@Model.PromoCode</span></span>
                        <span>−@((Model.Subtotal - Model.TotalCost)?.ToString("C0"))</span>
                    </div>
                }
                <div class="summary-total mb-4">
                    <span class="fw-bold">Итого (@Model.ItemsQuantity шт.)</span>
                    <span class="price">@Model.TotalCost?.ToString("C0")</span>
                </div>
                <button class="btn btn-accent btn-lg w-100" type="submit">
                    <i class="bi bi-check2-circle me-2"></i>Подтвердить заказ
                </button>
                <p class="small text-muted text-center mt-3 mb-0">Нажимая кнопку, вы соглашаетесь с <a asp-controller="Home" asp-action="Privacy">политикой конфиденциальности</a></p>
            </aside>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/index.js" asp-append-version="true"></script>
}
