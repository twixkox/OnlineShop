@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}

<section class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="ProfileEdit">Личный кабинет</a></li>
            <li class="breadcrumb-item active" aria-current="page">Смена пароля</li>
        </ol>
    </nav>
    <h1>Смена пароля</h1>
    <p>Обновите пароль для защиты аккаунта</p>
</section>

<div class="row g-4">
    <div class="col-lg-4 col-xl-3">
        <partial name="_ProfileNav" />
    </div>
    <div class="col-lg-8 col-xl-6">
        <div class="surface surface-pad" data-reveal style="--d:.1s">
            <form asp-controller="Profile" asp-action="EditPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Текущий пароль</label>
                    <div class="form-icon-field">
                        <i class="bi bi-lock"></i>
                        <input asp-for="CurrentPassword" class="form-control" type="password" id="currentPassword" autocomplete="current-password" />
                        <button class="pass-toggle" type="button" onclick="togglePassword('currentPassword', this)" aria-label="Показать пароль"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">Новый пароль</label>
                    <div class="form-icon-field">
                        <i class="bi bi-key"></i>
                        <input asp-for="NewPassword" class="form-control" type="password" id="newPassword" autocomplete="new-password" />
                        <button class="pass-toggle" type="button" onclick="togglePassword('newPassword', this)" aria-label="Показать пароль"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="progress mt-2" style="height:6px;" aria-hidden="true">
                        <div class="progress-bar" id="passStrength" style="width:0%; transition: width .4s ease, background-color .4s ease;"></div>
                    </div>
                    <div class="form-text" id="passStrengthText">Не менее 6 символов. Надёжнее — буквы, цифры и символы</div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Повторите пароль</label>
                    <div class="form-icon-field">
                        <i class="bi bi-check2-circle"></i>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" id="confirmPassword" autocomplete="new-password" />
                        <button class="pass-toggle" type="button" onclick="togglePassword('confirmPassword', this)" aria-label="Показать пароль"><i class="bi bi-eye"></i></button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2">
                    <a asp-controller="Profile" asp-action="ProfileEdit" class="btn btn-outline-secondary px-4">Отмена</a>
                    <button type="submit" class="btn btn-success px-5"><i class="bi bi-shield-check me-2"></i>Сменить пароль</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Индикатор надёжности пароля
        (function () {
            const input = document.getElementById('newPassword');
            const bar = document.getElementById('passStrength');
            const text = document.getElementById('passStrengthText');
            if (!input || !bar) return;
            const levels = [
                { w: 0, c: '#dee2e6', t: 'Не менее 6 символов. Надёжнее — буквы, цифры и символы' },
                { w: 25, c: '#c4453c', t: 'Слабый пароль' },
                { w: 50, c: '#e0a030', t: 'Средний пароль' },
                { w: 75, c: '#74c69d', t: 'Хороший пароль' },
                { w: 100, c: '#2d6a4f', t: 'Отличный пароль' }
            ];
            input.addEventListener('input', () => {
                const v = input.value;
                let score = 0;
                if (v.length >= 6) score++;
                if (v.length >= 10) score++;
                if (/[A-ZА-Я]/.test(v) && /[a-zа-я]/.test(v)) score++;
                if (/\d/.test(v) && /[^\wА-Яа-я]/.test(v)) score++;
                if (!v) score = 0; else score = Math.max(1, score);
                const l = levels[score];
                bar.style.width = l.w + '%';
                bar.style.backgroundColor = l.c;
                text.textContent = l.t;
            });
        })();
    </script>
}
