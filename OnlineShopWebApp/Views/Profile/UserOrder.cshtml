@model List<OrderViewModel>
@{
    ViewData["Title"] = "Мои заказы";
}

<section class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="ProfileEdit">Личный кабинет</a></li>
            <li class="breadcrumb-item active" aria-current="page">Мои заказы</li>
        </ol>
    </nav>
    <h1>Мои заказы</h1>
    <p>@(Model?.Any() == true ? $"Всего заказов: {Model.Count}" : "История ваших покупок")</p>
</section>

<div class="row g-4">
    <div class="col-lg-4 col-xl-3">
        <partial name="_ProfileNav" />
    </div>
    <div class="col-lg-8 col-xl-9">
        @if (Model != null && Model.Any())
        {
            <div class="d-grid gap-3" data-stagger=".06">
                @foreach (var order in Model)
                {
                    <a class="order-card" asp-controller="Profile" asp-action="DetailOrder" asp-route-orderId="@order.Id">
                        <div class="feature-ico" style="width:48px;height:48px;"><i class="bi bi-box-seam"></i></div>
                        <div>
                            <div class="fw-bold">Заказ № @order.Id.ToString()[..8].ToUpperInvariant()</div>
                            <div class="meta">@order.CreationDateOrder.ToString("d MMMM yyyy, HH:mm") · @order.ItemsQuantity шт.</div>
                        </div>
                        <span class="status-badge status-@order.Status">@Html.DisplayFor(m => order.Status)</span>
                        <span class="price" style="font-size:1.15rem;">@order.TotalCost?.ToString("C0")</span>
                        <i class="bi bi-chevron-right go"></i>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="surface empty-state" data-reveal>
                <div class="ico"><i class="bi bi-bag"></i></div>
                <h3>Заказов пока нет</h3>
                <p>Самое время выбрать что-нибудь для сада.</p>
                <a asp-controller="Catalog" asp-action="AllProducts" class="btn btn-success btn-lg">
                    <i class="bi bi-grid me-2"></i>Перейти в каталог
                </a>
            </div>
        }
    </div>
</div>
