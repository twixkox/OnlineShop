@using OnlineShopWebApp.Models
@model EditUserInfoViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<OnlineShop.Db.Models.User> UserManager
@{
    var profileUser = await UserManager.GetUserAsync(User);
    var avatarUrl = UiHelper.AvatarUrl(profileUser?.ProfileImage);
    var hasCustomAvatar = avatarUrl != UiHelper.DefaultAvatar;
    ViewData["Title"] = "Личные данные";
}

<section class="page-hero">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Главная</a></li>
            <li class="breadcrumb-item active" aria-current="page">Личный кабинет</li>
        </ol>
    </nav>
    <h1>Личные данные</h1>
    <p>Эти данные подставляются при оформлении заказа</p>
</section>

<div class="row g-4">
    <div class="col-lg-4 col-xl-3">
        <partial name="_ProfileNav" />
    </div>
    <div class="col-lg-8 col-xl-9">
        @if (Model == null)
        {
            <div class="surface empty-state">
                <div class="ico"><i class="bi bi-person-x"></i></div>
                <h3>Пользователь не найден</h3>
                <p>Попробуйте выйти и войти в аккаунт заново.</p>
            </div>
        }
        else
        {
            <div class="surface surface-pad mb-4 avatar-block" data-reveal style="--d:.05s">
                <img src="@avatarUrl" alt="Фото профиля" class="avatar-lg">
                <div class="flex-grow-1">
                    <h5 class="mb-1">Фото профиля</h5>
                    <p class="text-muted small mb-3">JPG, PNG или WEBP до 5 МБ. Фото обрежется до квадрата.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <form asp-controller="Profile" asp-action="Avatar" method="post" enctype="multipart/form-data" data-no-loader>
                            <label class="btn btn-outline-success mb-0">
                                <i class="bi bi-upload me-1"></i>Загрузить фото
                                <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" hidden onchange="this.form.submit()">
                            </label>
                        </form>
                        @if (hasCustomAvatar)
                        {
                            <form asp-controller="Profile" asp-action="Avatar" method="post" data-no-loader>
                                <input type="hidden" name="remove" value="true" />
                                <button type="submit" class="btn btn-outline-secondary">Удалить</button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            <div class="surface surface-pad" data-reveal style="--d:.1s">
                <form asp-controller="Profile" asp-action="ProfileEdit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label class="form-label">Email (логин)</label>
                        <div class="form-icon-field">
                            <i class="bi bi-envelope"></i>
                            <input class="form-control bg-light" value="@Model.UserName" readonly disabled />
                        </div>
                        <div class="form-text">Email используется для входа и не меняется</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" asp-for="FirstName">Имя</label>
                            <input class="form-control" asp-for="FirstName" placeholder="Введите имя" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" asp-for="LastName">Фамилия</label>
                            <input class="form-control" asp-for="LastName" placeholder="Введите фамилию" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label" asp-for="Phone">Телефон</label>
                        <div class="form-icon-field">
                            <i class="bi bi-telephone"></i>
                            <input class="form-control phone-input" asp-for="Phone" type="tel" placeholder="+7 (999) 999-99-99" autocomplete="tel" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap justify-content-end gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                        <button type="submit" class="btn btn-success px-5">
                            <i class="bi bi-check2 me-2"></i>Сохранить
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>
