@model OrderViewModel
@{
    var number = Model?.Id.ToString()[..8].ToUpperInvariant();
    ViewData["Title"] = Model != null ? $"Заказ № {number}" : "Заказ не найден";
    var steps = new[]
    {
        (OrderStatusViewModel.Created, "Создан"),
        (OrderStatusViewModel.Processed, "В обработке"),
        (OrderStatusViewModel.Delivering, "В пути"),
        (OrderStatusViewModel.Delivered, "Доставлен")
    };
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="ProfileEdit">Личный кабинет</a></li>
                <li class="breadcrumb-item"><a asp-controller="Profile" asp-action="UserOrder">Мои заказы</a></li>
                <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
            </ol>
        </nav>
        <h1>@ViewData["Title"]</h1>
        @if (Model != null)
        {
            <p>от @Model.CreationDateOrder.ToString("d MMMM yyyy, HH:mm")</p>
        }
    </div>
    <a asp-controller="Profile" asp-action="UserOrder" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>Все заказы</a>
</section>

@if (Model == null)
{
    <div class="surface empty-state" data-reveal>
        <div class="ico"><i class="bi bi-question-lg"></i></div>
        <h3>Заказ не найден</h3>
        <p>Возможно, ссылка устарела или заказ принадлежит другому пользователю.</p>
        <a asp-controller="Profile" asp-action="UserOrder" class="btn btn-success btn-lg">К списку заказов</a>
    </div>
    return;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="surface surface-pad mb-4" data-reveal>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0">Статус</h5>
                <span class="status-badge status-@Model.Status">@Html.DisplayFor(m => m.Status)</span>
            </div>
            @if (Model.Status != OrderStatusViewModel.Canceled)
            {
                <div class="order-timeline">
                    @for (var i = 0; i < steps.Length; i++)
                    {
                        var done = (int)Model.Status >= (int)steps[i].Item1;
                        <div class="t-step @(done ? "done" : "")" style="--d: @(i * .25)s">
                            <div class="t-bar"></div>
                            @steps[i].Item2
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mt-3 mb-0">Заказ был отменён. Если это ошибка — позвоните нам: <a href="tel:+78129250508">+7 (812) 925-05-08</a></p>
            }
        </div>

        <div class="surface surface-pad" data-reveal style="--d:.1s">
            <h5 class="mb-2">Состав заказа</h5>
            @foreach (var item in Model.Items)
            {
                var image = UiHelper.ProductImage(item.Product?.ThumbnailsPhotoPath, item.Product?.PhotoPath);
                <div class="cart-row">
                    <a class="cart-thumb" asp-controller="Product" asp-action="Index" asp-route-id="@item.Product?.Id">
                        <img src="@image" alt="@item.Product?.Name" class="@(image == UiHelper.PlaceholderImage ? "is-placeholder" : "")" loading="lazy">
                    </a>
                    <div>
                        <a class="name" asp-controller="Product" asp-action="Index" asp-route-id="@item.Product?.Id">@item.Product?.Name</a>
                        <div class="text-muted small mt-1">@item.Quantity × @item.Product?.Cost.ToString("C0")</div>
                    </div>
                    <div class="controls"><span class="line-total">@item.Cost.ToString("C0")</span></div>
                </div>
            }
            <div class="summary-total">
                <span class="fw-bold">Итого</span>
                <span class="price">@Model.TotalCost?.ToString("C0")</span>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <aside class="surface surface-pad summary" data-reveal style="--d:.15s">
            <h5 class="mb-3">Доставка</h5>
            <ul class="info-list">
                <li><i class="bi bi-person"></i><span class="text-body">@Model.DeliveryUserInfo?.UserName</span></li>
                <li><i class="bi bi-telephone"></i><span class="text-body">@Model.DeliveryUserInfo?.Phone</span></li>
                <li>
                    <i class="bi bi-geo-alt"></i>
                    <span class="text-body">
                        @Model.DeliveryUserInfo?.Adress@(string.IsNullOrEmpty(Model.DeliveryUserInfo?.Apartment) ? "" : $", {Model.DeliveryUserInfo.Apartment}")
                    </span>
                </li>
                <li><i class="bi bi-calendar-event"></i><span class="text-body">@Model.DeliveryUserInfo?.DeliveryDate.ToString("d MMMM yyyy")</span></li>
                @if (!string.IsNullOrEmpty(Model.DeliveryUserInfo?.Comment))
                {
                    <li><i class="bi bi-chat-left-text"></i><span>@Model.DeliveryUserInfo.Comment</span></li>
                }
            </ul>
        </aside>
    </div>
</div>
