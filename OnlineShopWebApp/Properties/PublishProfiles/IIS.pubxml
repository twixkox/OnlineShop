<?xml version="1.0" encoding="utf-8"?>
<!--
  Публикация для IIS: в Visual Studio — правой кнопкой по проекту → Publish → профиль «IIS» → Publish,
  из командной строки — dotnet publish OnlineShopWebApp -p:PublishProfile=IIS
  Результат: OnlineShopWebApp\bin\Publish\IIS — папка site\ и скрипт deploy.ps1 для сервера.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Publish\IIS\site\</PublishDir>
    <PublishUrl>bin\Publish\IIS\site\</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
  </PropertyGroup>

  <!-- Рядом с сайтом кладём скрипт обновления сервера и образец настроек -->
  <Target Name="CopyIisDeployScripts" AfterTargets="Publish">
    <ItemGroup>
      <IisDeployFile Include="$(MSBuildProjectDirectory)\..\deploy\iis\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(IisDeployFile)" DestinationFolder="$(MSBuildProjectDirectory)\bin\Publish\IIS\" />
    <Message Importance="high" Text="Сборка для IIS: $(MSBuildProjectDirectory)\bin\Publish\IIS" />
  </Target>
</Project>
