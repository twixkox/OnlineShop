@model List<OnlineShop.Db.Models.Review>
@{
    ViewData["Title"] = "Отзывы";
}

<section class="page-hero">
    <h1>Отзывы покупателей</h1>
    <p>Последние @Model.Count отзывов. Неуместные можно удалить.</p>
</section>

@if (!Model.Any())
{
    <div class="surface empty-state">
        <div class="ico"><i class="bi bi-chat-square-text"></i></div>
        <h3>Отзывов пока нет</h3>
    </div>
}
else
{
    <div class="row g-3" data-stagger=".04">
        @foreach (var r in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="review-card h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div>
                            <div class="fw-bold">@r.UserName</div>
                            <div class="small text-muted">@r.CreatedAt.ToString("d MMMM yyyy, HH:mm")</div>
                        </div>
                        <partial name="_Stars" model="(double)r.Rating" />
                    </div>
                    <a class="small fw-semibold mb-2" asp-area="" asp-controller="Product" asp-action="Index" asp-route-id="@r.ProductId">@r.Product?.Name</a>
                    <p class="flex-grow-1 mb-3">@(string.IsNullOrEmpty(r.Text) ? "Без текста" : r.Text)</p>
                    <form asp-action="Delete" asp-route-id="@r.Id" method="post" class="text-end" data-no-loader>
                        <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Удалить отзыв?"><i class="bi bi-trash me-1"></i>Удалить</button>
                    </form>
                </article>
            </div>
        }
    </div>
}
