@model List<OnlineShop.Db.Models.PromoCode>
@{
    ViewData["Title"] = "Промокоды";
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <h1>Промокоды</h1>
        <p>Скидки, которые покупатель вводит в корзине</p>
    </div>
    <a asp-action="Add" class="btn btn-light"><i class="bi bi-plus-lg me-1"></i>Новый промокод</a>
</section>

@if (!Model.Any())
{
    <div class="surface empty-state">
        <div class="ico"><i class="bi bi-ticket-perforated"></i></div>
        <h3>Промокодов пока нет</h3>
        <a asp-action="Add" class="btn btn-success btn-lg">Создать промокод</a>
    </div>
}
else
{
    <div class="surface p-0 overflow-hidden" data-reveal>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th class="ps-4">Код</th><th>Скидка</th><th>От суммы</th><th>Действует до</th><th>Статус</th><th class="text-end pe-4">Действия</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        var expired = p.ValidUntil.HasValue && p.ValidUntil.Value.Date < DateTime.Today;
                        <tr>
                            <td class="ps-4"><span class="promo-chip">@p.Code</span><div class="small text-muted mt-1">@p.Description</div></td>
                            <td class="fw-bold">@p.DiscountPercent%</td>
                            <td>@(p.MinOrderAmount > 0 ? p.MinOrderAmount.ToString("C0") : "—")</td>
                            <td>@(p.ValidUntil?.ToString("d MMMM yyyy") ?? "бессрочно")</td>
                            <td>
                                @if (!p.IsActive)
                                {
                                    <span class="status-badge status-Created">Выключен</span>
                                }
                                else if (expired)
                                {
                                    <span class="status-badge status-Canceled">Истёк</span>
                                }
                                else
                                {
                                    <span class="status-badge status-Delivered">Активен</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Редактировать"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" data-no-loader>
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Удалить" data-confirm="Удалить промокод @p.Code?"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
