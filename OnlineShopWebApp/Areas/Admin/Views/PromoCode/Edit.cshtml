@model OnlineShopWebApp.Areas.Admin.Models.PromoCodeViewModel
@{
    var isNew = Model.Id == Guid.Empty;
    ViewData["Title"] = isNew ? "Новый промокод" : $"Промокод {Model.Code}";
}

<section class="page-hero d-flex justify-content-between align-items-end">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p>Покупатель вводит код в корзине — скидка применяется ко всему заказу</p>
    </div>
    <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left me-1"></i>К списку</a>
</section>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="surface surface-pad" data-reveal>
            <form asp-action="Save" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert validation-summary-errors"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label"></label>
                        <input asp-for="Code" class="form-control text-uppercase" autocomplete="off" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DiscountPercent" class="form-label"></label>
                        <input asp-for="DiscountPercent" type="number" min="1" max="90" class="form-control" />
                        <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MinOrderAmount" class="form-label"></label>
                        <input asp-for="MinOrderAmount" type="number" min="0" step="1" class="form-control" />
                        <span asp-validation-for="MinOrderAmount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ValidUntil" class="form-label"></label>
                        <input asp-for="ValidUntil" type="date" class="form-control" />
                        <div class="form-text">Пусто — бессрочно</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" role="switch" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-success px-5">Сохранить</button>
                </div>
            </form>
        </div>
    </div>
</div>
